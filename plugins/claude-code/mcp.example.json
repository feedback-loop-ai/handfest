{
  "mcpServers": {
    "github-handfest": {
      "command": "handfest-mcp",
      "args": [
        "--chain",
        "/path/to/handfest-config/mandates/root.signed.json",
        "--ledger",
        "/path/to/handfest-config/state/handfest-ledger.sqlite",
        "--actor-key",
        "ed25519:<agent-public-key-hex>",
        "--policy-map",
        "/path/to/handfest-config/policy-map.json",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    }
  }
}
