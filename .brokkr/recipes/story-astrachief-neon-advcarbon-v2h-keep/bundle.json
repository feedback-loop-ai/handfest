{
  "name": "story-astrachief-neon-advcarbon-v2h-keep",
  "description": "Story delivery with agy seated (operator, 2026-11-22: 'neon as implementer', 'move the seat off qwen, I'd say put it to Carbon with Fable fallback'): Gemini 4 Neon implements at high with boxed hands; the review panel is Gemini 4 Carbon adversarial at high (the security position; Claude Fable 5.2 at medium behind it) and gpt-6.2-sol correctness at medium; the gpt-6.2-astra chief judges at medium, sol (high) its fallback. Verify's deadline is 7200 s and it keeps each command's output.",
  "cost": "medium",
  "policy": "policy.json",
  "protected_phase": "review",
  "seats": {
    "implement": {
      "results": [
        "complete",
        "broken",
        "blocked",
        "oversized"
      ],
      "class": "work",
      "agent": "story-implementer-neon"
    },
    "verify": {
      "results": [
        "pass",
        "fail"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 7200
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/verify-seat.sh",
          "{prompt_file}"
        ]
      },
      "hands": {
        "kind": "workspace",
        "network": false,
        "binds": [
          {
            "path": "~/.cargo",
            "mode": "overlay",
            "mask": [
              "credentials.toml",
              "credentials"
            ]
          },
          {
            "path": "~/.rustup",
            "mode": "ro"
          }
        ]
      }
    },
    "review": {
      "results": [
        "clean",
        "residual",
        "security-hold"
      ],
      "inputs": [
        "has_security_residual",
        "max_residual_severity"
      ],
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 28800
      },
      "sequence": [
        {
          "name": "positions",
          "results": [
            "clean",
            "residual",
            "security-hold"
          ],
          "aggregate": "review-panel",
          "panel": {
            "adversarial": {
              "agent": "bugfix-review-adversarial-carbon",
              "class": "work"
            },
            "correctness": {
              "agent": "bugfix-review-correctness-sol",
              "class": "work"
            }
          }
        },
        {
          "name": "chief",
          "agent": "bugfix-review-chief-astra",
          "class": "gate"
        }
      ]
    },
    "ship": {
      "results": [
        "ready",
        "shipped"
      ],
      "class": "gate",
      "limits": {
        "max_attempts": 2,
        "timeout_seconds": 1800
      },
      "driver": {
        "command": [
          "{brokkr}",
          "driver",
          "exec",
          "--",
          "bash",
          "./scripts/ship-seat.sh",
          "{prompt_file}",
          "{brokkr}"
        ]
      },
      "hands": {
        "kind": "workspace",
        "network": false,
        "binds": []
      }
    }
  }
}